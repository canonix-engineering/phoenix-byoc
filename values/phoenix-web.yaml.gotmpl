{{- $databaseHost := .Values.postgresql.external.host }}
{{- $databaseSslmode := .Values.postgresql.external.sslmode }}
{{- if .Values.postgresql.bundled.enabled }}
{{- $databaseHost = "postgresql-postgresql" }}
{{- $databaseSslmode = "disable" }}
{{- end }}
{{- $repository := .Values.images.phoenixWeb.repository }}
{{- if .Values.imageRegistry }}
{{- $repository = printf "%s/%s" (trimSuffix "/" .Values.imageRegistry) .Values.images.phoenixWeb.name }}
{{- end }}
{{- $redisUrl := .Values.secrets.redis.url }}
{{- if .Values.redis.bundled.enabled }}
{{- $redisUrl = printf "redis://redis-client.%s.svc.%s:6379/1" .Values.namespace .Values.clusterDomain }}
{{- else }}
{{- $redisUrl = required "secrets.redis.url is required when bundled Redis is disabled" $redisUrl }}
{{- end }}
{{- $adminUrl := .Values.secrets.postgresql.adminUrl }}
{{- if .Values.postgresql.bundled.enabled }}
{{- $adminUrl = printf "postgresql://postgres:%s@postgresql-postgresql:%v/postgres?sslmode=disable" .Values.secrets.postgresql.superuserPassword .Values.postgresql.external.port }}
{{- end }}
{{- $internalServiceTokens := .Values.secrets.application.internalServiceTokens }}
{{- $mailDeliveryMethod := .Values.application.mailer.deliveryMethod | default "mailgun" }}
{{- if not $internalServiceTokens }}
{{- $internalServiceTokens = printf `[{"identity":"phoenix-gateway","token":%q,"scopes":["workflow:artifacts:read","workflow:context:read","workflow:events:write"],"tenant_ids":[],"app_slugs":[]}]` .Values.secrets.application.workflowEngineToken }}
{{- end }}

image:
  repository: {{ $repository | quote }}
  tag: {{ .Values.images.phoenixWeb.tag | quote }}
  pullPolicy: {{ .Values.imagePullPolicy }}

imagePullSecrets:
{{ toYaml .Values.imagePullSecrets | indent 2 }}

web:
  railsEnv: production
  logLevel: info
  skipCsrf: false
  allowedHosts: {{ .Values.application.allowedHosts | quote }}
  actionCableAllowedOrigins: {{ .Values.application.actionCableAllowedOrigins | quote }}
  appHost: {{ .Values.application.appHost | quote }}
  spaHost: {{ required "application.spaHost is required" .Values.application.spaHost | quote }}
  tenantId: {{ .Values.application.tenantId | quote }}
  cortex:
    host: {{ required "application.cortex.host is required" .Values.application.cortex.host | quote }}
    scheme: {{ .Values.application.cortex.scheme | quote }}
  clickhouse:
    # The current chart requires a non-empty ConfigMap value. The real URL is
    # injected below from Secret/clickhouse and overrides this compatibility URL.
    url: "http://clickhouse.invalid/phoenix"
  extraEnv:
    - name: INVOCATION_LOGS_CLICKHOUSE_URL
      valueFrom:
        secretKeyRef:
          name: clickhouse
          key: CLICKHOUSE_HTTP_URL
  mcp:
    host: {{ printf "http://phoenix-gateway.%s.svc.%s:3002" .Values.namespace .Values.clusterDomain | quote }}
  phoenixGateway:
    url: {{ printf "http://phoenix-gateway.%s.svc.%s:3002" .Values.namespace .Values.clusterDomain | quote }}
  phoenixWeb:
    internalBaseUrl: {{ printf "http://phoenix-web.%s.svc.%s:80" .Values.namespace .Values.clusterDomain | quote }}
  workflowEngine:
    databaseUrl: {{ printf "postgres://%s:%s@%s:%v/%s?sslmode=%s&connect_timeout=10" .Values.postgresql.users.application .Values.secrets.postgresql.applicationPassword $databaseHost .Values.postgresql.external.port .Values.postgresql.databases.primary $databaseSslmode | quote }}
    artifactApiUrl: {{ printf "http://phoenix-workflow-engine-artifact-api.%s.svc.%s:8081" .Values.namespace .Values.clusterDomain | quote }}
    workflowApiUrl: {{ printf "http://phoenix-workflow-engine-api.%s.svc.%s:8080" .Values.namespace .Values.clusterDomain | quote }}
    startUrl: {{ printf "http://phoenix-workflow-engine-api.%s.svc.%s:8080/workflow-runs" .Values.namespace .Values.clusterDomain | quote }}
  redisUrl: {{ $redisUrl | quote }}
  mailer:
    from: {{ required "application.mailer.from is required" .Values.application.mailer.from | quote }}
    domain: {{ .Values.application.mailer.domain | quote }}
    deliveryMethod: {{ .Values.application.mailer.deliveryMethod | quote }}
    smtp:
      address: {{ .Values.application.mailer.smtp.address | quote }}
      port: {{ .Values.application.mailer.smtp.port | quote }}
      userName: {{ .Values.application.mailer.smtp.userName | quote }}
      authentication: {{ .Values.application.mailer.smtp.authentication | quote }}
      enableStarttlsAuto: {{ .Values.application.mailer.smtp.enableStarttlsAuto | quote }}
      heloDomain: {{ .Values.application.mailer.smtp.heloDomain | quote }}

conversationStream:
  # Match the source test environment: the independent conversation stream
  # reader is not enabled. web.redisUrl remains configured for web and worker.
  redisUrl: ""

worker:
  enabled: true
  replicaCount: {{ .Values.services.worker.replicas }}

server:
  replicaCount: {{ .Values.services.web.replicas }}

service:
  type: ClusterIP
  port: 80

ingress:
  enabled: {{ .Values.ingress.web.enabled }}
  className: {{ .Values.ingress.className | quote }}
  annotations:
{{ toYaml .Values.ingress.web.annotations | indent 4 }}
  hosts:
    - host: {{ .Values.ingress.web.host | quote }}
      paths:
        - path: /
          pathType: Prefix
  tls:
{{ toYaml .Values.ingress.web.tls | indent 4 }}

externalDatabase:
  host: {{ required "postgresql.external.host is required when bundled PostgreSQL is disabled" $databaseHost | quote }}
  port: {{ .Values.postgresql.external.port }}
  password: {{ required "secrets.postgresql.applicationPassword is required" .Values.secrets.postgresql.applicationPassword | quote }}
  init:
    enabled: {{ .Values.postgresql.hooks.phoenixWeb }}
    reloadWorkflowDefinitions: true
    runSeed: false
    adminUrl: {{ $adminUrl | quote }}

secret:
  secretKeyBase: {{ required "secrets.application.secretKeyBase is required" .Values.secrets.application.secretKeyBase | quote }}
  agentHarnessToken: {{ required "secrets.application.agentHarnessToken is required" .Values.secrets.application.agentHarnessToken | quote }}
  workflowEngineArtifactApiToken: {{ required "secrets.application.workflowEngineArtifactApiToken is required" .Values.secrets.application.workflowEngineArtifactApiToken | quote }}
  phoenixWorkflowEngineToken: {{ required "secrets.application.workflowEngineToken is required" .Values.secrets.application.workflowEngineToken | quote }}
  phoenixInternalServiceTokens: {{ $internalServiceTokens | quote }}
  githubPat: {{ .Values.secrets.agents.githubPat | quote }}
  mailgunApiKey: {{ if eq $mailDeliveryMethod "smtp" }}{{ .Values.secrets.application.mailgunApiKey | quote }}{{ else }}{{ required "secrets.application.mailgunApiKey is required when application.mailer.deliveryMethod is mailgun or empty" .Values.secrets.application.mailgunApiKey | quote }}{{ end }}
  smtpPassword: {{ .Values.secrets.application.smtpPassword | quote }}
  guardrailsTestToken: {{ required "secrets.application.guardrailsTestToken is required" .Values.secrets.application.guardrailsTestToken | quote }}
  jsTransformTestToken: {{ required "secrets.application.jsTransformTestToken is required" .Values.secrets.application.jsTransformTestToken | quote }}
  toolInvocationTestToken: {{ required "secrets.application.toolInvocationTestToken is required" .Values.secrets.application.toolInvocationTestToken | quote }}

nodeSelector:
{{ toYaml .Values.scheduling.nodeSelector | indent 2 }}
tolerations:
{{ toYaml .Values.scheduling.tolerations | indent 2 }}
affinity:
{{ toYaml .Values.scheduling.affinity | indent 2 }}
