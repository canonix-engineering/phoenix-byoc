{{- $repository := .Values.images.opensandboxController.repository }}
{{- $tag := .Values.images.opensandboxController.tag }}
{{- with .Values.images.opensandboxController.digest }}
{{- $tag = printf "%s@%s" $tag . }}
{{- end }}
{{- if .Values.imageRegistry }}
{{- $repository = printf "%s/%s" (trimSuffix "/" .Values.imageRegistry) .Values.images.opensandboxController.name }}
{{- end }}
{{- $imageCommitterRepository := .Values.images.opensandboxImageCommitter.repository }}
{{- if .Values.imageRegistry }}
{{- $imageCommitterRepository = printf "%s/%s" (trimSuffix "/" .Values.imageRegistry) .Values.images.opensandboxImageCommitter.name }}
{{- end }}
{{- $imageCommitterImage := printf "%s:%s" $imageCommitterRepository .Values.images.opensandboxImageCommitter.tag }}
{{- with .Values.images.opensandboxImageCommitter.digest }}
{{- $imageCommitterImage = printf "%s@%s" $imageCommitterImage . }}
{{- end }}

namespaceOverride: {{ .Values.namespace | quote }}

rbac:
  clusterRoleName: {{ printf "opensandbox-manager-role-%s" .Values.namespace | trunc 63 | trimSuffix "-" | quote }}

controller:
  image:
    repository: {{ $repository | quote }}
    tag: {{ $tag | quote }}
    pullPolicy: {{ .Values.imagePullPolicy }}
  replicaCount: 1
  logLevel: info
  kubeClient:
    qps: 0
    burst: 0
  snapshot:
{{- if .Values.opensandboxController.snapshot.enabled }}
    imageCommitterImage: {{ $imageCommitterImage | quote }}
    commitJobTimeout: {{ .Values.opensandboxController.snapshot.commitJobTimeout | quote }}
    registry: {{ .Values.opensandboxController.snapshot.registry | quote }}
    registryInsecure: {{ .Values.opensandboxController.snapshot.registryInsecure }}
    snapshotPushSecret: {{ .Values.opensandboxController.snapshot.secretName | quote }}
    resumePullSecret: {{ .Values.opensandboxController.snapshot.secretName | quote }}
{{- else }}
    imageCommitterImage: ""
    commitJobTimeout: ""
{{- end }}
  nodeSelector:
{{ toYaml .Values.scheduling.nodeSelector | indent 4 }}
  tolerations:
{{ toYaml .Values.scheduling.tolerations | indent 4 }}
  affinity:
{{ toYaml .Values.scheduling.affinity | indent 4 }}
  resources:
{{ toYaml .Values.opensandboxController.resources | indent 4 }}

imagePullSecrets:
{{ toYaml .Values.imagePullSecrets | indent 2 }}

crds:
  install: {{ .Values.opensandboxController.crds.install }}
  keep: {{ .Values.opensandboxController.crds.keep }}
