# Never commit the populated values.secrets.yaml.
secrets:
  registry:
    ecr:
      # Required only when registry.ecrRefresh.enabled=true and no existing
      # credentialsSecretName is configured.
      accessKeyId: ""
      secretAccessKey: ""
      sessionToken: ""
  postgresql:
    superuserPassword: ""
    applicationPassword: CHANGE_ME
    internalPassword: CHANGE_ME
    # Required while either PostgreSQL hook is enabled.
    adminUrl: CHANGE_ME_ADMIN_POSTGRESQL_URL
  redis:
    # Empty while bundled Redis is enabled.
    url: ""
  cortex:
    password: CHANGE_ME
    # Empty while bundled Cortex PostgreSQL is enabled.
    url: ""
  application:
    secretKeyBase: CHANGE_ME
    workflowEngineArtifactApiToken: CHANGE_ME
    workflowEngineToken: CHANGE_ME
    internalServiceTokens: ""
    mailgunApiKey: CHANGE_ME
    guardrailsTestToken: CHANGE_ME
    jsTransformTestToken: CHANGE_ME
    toolInvocationTestToken: CHANGE_ME
  agents:
    claudeCodeOauthToken: ""
    anthropicApiKey: ""
    githubPat: ""
    githubToken: ""
    openaiApiKey: ""
    geminiApiKey: ""
